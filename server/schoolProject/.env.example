# Copy to server/schoolProject/.env and fill in real values. Never commit .env.
# Django does not load this file automatically. Export it before running commands, e.g.
#   set -a; source .env; set +a

# Required when DJANGO_DEBUG is off. Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=replace-with-a-long-random-string

# Set to True only for local development.
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Origins allowed to call the API from a browser (comma-separated).
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Base URL of the frontend, used to build password-reset links.
FRONTEND_URL=http://localhost:5173

# Email. The console backend prints emails to the terminal (fine for development).
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@brightpath.local
